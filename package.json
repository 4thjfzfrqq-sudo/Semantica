// Script de génération des données sémantiques
// À lancer UNE SEULE FOIS avec : node scripts/generate.mjs
// Nécessite : ANTHROPIC_API_KEY dans l'environnement

import fs from "fs";
import path from "path";

const WORDS = [
  // Nature & paysages
  "cascade", "volcan", "glacier", "marécage", "falaise", "dune", "torrent", "prairie",
  "brume", "rosée", "avalanche", "grotte", "delta", "récif", "toundra", "savane",
  // Émotions & psychologie
  "nostalgie", "mélancolie", "euphorie", "angoisse", "sérénité", "fierté", "honte",
  "jalousie", "empathie", "solitude", "gratitude", "rancœur", "espoir", "désespoir",
  // Gastronomie
  "mijoter", "fricassée", "brioche", "pâtisserie", "millefeuille", "bouillon", "farce",
  "marinade", "sauté", "velouté", "croûton", "compote", "mousse", "ganache",
  // Sciences & tech
  "algorithme", "nébuleuse", "molécule", "chromosome", "entropie", "photon", "enzyme",
  "fractale", "quasar", "plasma", "neurone", "isotope", "vecteur", "prisme",
  // Culture & arts
  "symphonie", "fresque", "calligraphie", "métaphore", "sonnet", "improvisation",
  "sculpture", "opéra", "aquarelle", "rhapsodie", "triptique", "libretto", "épopée",
  // Sport & mouvement
  "sprint", "esquive", "plongeon", "galop", "feinte", "slalom", "vrille", "amorti",
  "contre-attaque", "rebond", "jongle", "tacle", "smash", "récupération",
  // Histoire & géographie
  "empire", "amnistie", "croisade", "exode", "siège", "traité", "diaspora",
  "conquistador", "révolution", "aristocratie", "tribut", "mercenaire", "bastion",
  // Vie quotidienne & société
  "routine", "voisinage", "embouteillage", "banlieue", "marché", "rumeur", "tradition",
  "rituel", "confiance", "solidarité", "partage", "compromis", "résilience",
  // Temps & espace
  "aube", "crépuscule", "éternité", "instant", "fugacité", "horizon", "profondeur",
  "immensité", "vertige", "silence", "frontière", "labyrinthe", "carrefour",
  // Abstractions
  "paradoxe", "chaos", "harmonie", "équilibre", "symétrie", "contraste", "nuance",
  "ambiguïté", "transparence", "complexité", "simplicité", "authenticité",
];

const SYSTEM_PROMPT = `Tu es un expert en sémantique française. Pour un jeu de devinette sémantique, tu dois générer une liste de mots associés à un mot cible.

RÈGLES IMPORTANTES :
- Les associations doivent être VRAIMENT pertinentes, pas juste statistiques
- Couvre plusieurs angles : synonymes, hyperonymes, hyponymes, contextes d'usage, images évoquées
- Les scores doivent être cohérents et utiles pour guider un joueur
- Évite les mots trop génériques comme "chose", "faire", "être"
- Inclus des mots surprenants mais justes qui enrichissent la compréhension

Format de réponse : JSON uniquement, sans markdown.
Structure : {"mot": "xxx", "associations": [{"mot": "yyy", "score": 850}, ...]}
Les scores vont de 1 à 999 (jamais 1000, réservé au mot exact).
Génère exactement 500 associations par mot, du plus proche (score ~950) au plus lointain (score ~10).`;

async function generateForWord(word) {
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "x-api-key": process.env.ANTHROPIC_API_KEY,
      "anthropic-version": "2023-06-01",
    },
    body: JSON.stringify({
      model: "claude-opus-4-5",
      max_tokens: 8000,
      system: SYSTEM_PROMPT,
      messages: [{
        role: "user",
        content: `Génère 500 associations pour le mot : "${word}"\n\nAssure-toi de couvrir :\n- Synonymes et mots très proches (score 800-950)\n- Mots du même champ sémantique (score 500-800)\n- Contextes d'usage, images évoquées (score 200-500)\n- Associations lointaines mais réelles (score 10-200)`,
      }],
    }),
  });

  if (!res.ok) throw new Error(`API error ${res.status} for word "${word}"`);
  const data = await res.json();
  const text = data.content?.find(b => b.type === "text")?.text || "";
  const clean = text.replace(/```json|```/g, "").trim();
  return JSON.parse(clean);
}

async function main() {
  console.log(`🚀 Génération de ${WORDS.length} mots secrets...`);
  const allData = {};
  const outputPath = path.join("data", "words.json");

  // Load existing if any
  if (fs.existsSync(outputPath)) {
    Object.assign(allData, JSON.parse(fs.readFileSync(outputPath, "utf8")));
    console.log(`📂 ${Object.keys(allData).length} mots déjà générés, reprise...`);
  }

  for (let i = 0; i < WORDS.length; i++) {
    const word = WORDS[i];
    if (allData[word]) {
      console.log(`⏭️  [${i+1}/${WORDS.length}] "${word}" déjà présent`);
      continue;
    }
    try {
      console.log(`⏳ [${i+1}/${WORDS.length}] Génération de "${word}"...`);
      const result = await generateForWord(word);
      // Sort by score desc, build lookup map
      const sorted = result.associations.sort((a, b) => b.score - a.score);
      allData[word] = sorted.reduce((acc, { mot, score }) => {
        acc[mot.toLowerCase()] = score;
        return acc;
      }, {});
      fs.writeFileSync(outputPath, JSON.stringify(allData, null, 2));
      console.log(`✅ "${word}" → ${sorted.length} associations sauvegardées`);
      // Rate limit pause
      await new Promise(r => setTimeout(r, 1000));
    } catch (e) {
      console.error(`❌ Erreur pour "${word}":`, e.message);
    }
  }

  // Generate word list for the game
  const wordList = Object.keys(allData);
  fs.writeFileSync(path.join("data", "wordlist.json"), JSON.stringify(wordList, null, 2));
  console.log(`\n🎉 Terminé ! ${wordList.length} mots générés.`);
}

main();
